                                <i class="fa-brands fa-twitter ic"></i>
                                <i class="fa-brands fa-whatsapp-square ic"></i>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card mx-auto shadow-lg border border-0">
                        <img src="~/Content/images/pexels-muzamilhussain-30422696.jpg" class="card-img-top img-fluid teamimg" alt="...">
