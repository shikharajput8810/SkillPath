
@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
}
<form method="post">
    <div class="container-fluid">
        <div class="row py-2">
            <p class="fs-3 text-center">Contact <b class="text-mycolor">Us</b></p>
            <div class="col-sm-10 mx-auto">
                <div class="row py-3">
                    <div class="col-sm-6 p-3 shadow-lg">
                        <div class="input-group flex-nowrap mt-3 shadow-lg">
                            <span class="input-group-text" id="addon-wrapping"><i class="fa-solid fa-user"></i></span>
                            <input type="text" class="form-control" placeholder="Enter Your Username" required name="name" aria-label="Username" aria-describedby="addon-wrapping">
                        </div>

                        <div class="input-group flex-nowrap mt-3 shadow-lg">
                            <span class="input-group-text" id="addon-wrapping"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" class="form-control" placeholder="Enter Your Email" required name="email" aria-label="Username" aria-describedby="addon-wrapping">
                        </div>
                        <div class="input-group flex-nowrap shadow-lg mt-3">
                            <span class="input-group-text" id="addon-wrapping"><i class="fa-solid fa-phone"></i></span>
                            <input type="number" class="form-control" placeholder="Enter your Number" required  name="number" aria-label="Username" aria-describedby="addon-wrapping">
                        </div>
                        <textarea class="form-control mt-3" placeholder="Enter Your Message" name="message" style="resize:none;"></textarea>
                        <input type="submit" value="Submit Now" class="form-control mt-2 bg-mycolor text-light" />
                    </div>
                    <div class="col-sm-6">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6447.052448927366!2d80.92337247354587!3d26.83803340283068!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399bfdad90bb35b9%3A0xa46d026d3a1699d1!2sYork%20Inn%20Boutique%20Hotel!5e0!3m2!1sen!2sin!4v1753787218244!5m2!1sen!2sin" width="600" height="290" class="w-100" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

