
@{
    ViewBag.Title = "Application";
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
}

<div class="row py-2">
    <div class="col-sm-12">
        <p class="fs-3 text-center">Your Job Application<b class="text-mycolor"> Status</b></p>
        <hr class="mx-auto w-30" />
        <form method="get">
            <div class="row">
                <div class="col-sm-10 mt-5 shadow p-3 mb-5 bg-body rounded mx-auto">
                    

                    <div class="row">
                        
                           
                            <div class="col-sm-4">
                                <div class="form-floating mb-3">
                                    <input type="email" class="form-control" id="floatingfrom" name="email" placeholder="name@example.com" />
                                    <label for="floatingfrom">Enter your emailid</label>
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <input type="submit" class="btn btn-mycolor" value="View Report" />
                            </div>
                        </div>
                    </div>
                </div>
        </form>
        @if (ViewBag.app != null)
        { 
           <table class="table table-striped table-bordered">
               <thead>
                   <tr>
                       <th>Name</th>
                       <th>Apply On</th>
                       <th>Is Hired</th>
                       <th>Is Rejected</th>
                   </tr>
               </thead>
               <tbody>
                   
                       @foreach(System.Data.DataRow row in ViewBag.app.Rows)
                {
                     <tr>
                         <td>@row["name"]</td>
                         <td>@row["jid"]</td>
                         <td>@row["ishired"]</td>
                         <td>@row["isrejected"]</td>
                      </tr>
                }
                   
               </tbody>
           </table>
        }
    </div>
</div>


