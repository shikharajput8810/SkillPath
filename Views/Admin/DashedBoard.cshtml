
@{
    ViewBag.Title = "DashedBoard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row py-2">
        <p class="fs-3 text-center"><b class="text-mycolor">Welcome to DashedBoard</b></p>
