
@{
    ViewBag.Title = "emplist";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

    <div class="container-fluid">
        <div class="row py-2">
            <div class="col-sm-12">
                <p class="fs-3 text-center">All Employee<b class="text-mycolor">List</b></p>
                <hr class="mx-auto w-30" />
            </div>
        </div>
        <!--tbl_application - delete all, tbl_emplogin-delete all-->
        <div class="row">
            <div class="col-sm-10 mx-auto mt-2">
                <div class="row">
                    @foreach (System.Data.DataRow row in ViewBag.employee.Rows)
                    {
                        <!--Employee card Start-->
                        <div class="col-sm-3 shadow p-3 mb-5 bg-white rounded">
                            <div class="card">
                                <img src="~/Content/profile/@row["picture"]" class="card-img-top" alt="...">
                                <div class="card-body">
                                    <h5 class="card-title">@row["name"]</h5>
                                    <p class="card-text">
                                        <i class="fa-solid fa-envelope"></i>@row["emailid"]
                                        <span class="text-secondary">
                                            <small>
                                                <i class="fa-solid fa-phone"></i>@row["mobno"]<br />
                                                <i class="fa-solid fa-money-check-dollar"></i>@row["salary"]
                                                <i class="fa-solid fa-person"></i>@row["gender"]
                                                <i class="fa-solid fa-location"></i>@row["address"]<br />
                                                Experience:@row["exp"]<br />
                                                Qualification:@row["qualification"]<br />
                                            </small>
                                        </span>
                                        <a href=""><span class="badge bg-danger">@row["resume"]</span></a>
                                        <span class="badge bg-danger">Download Resume</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <!--Employee card End-->
                    }
                </div>
            </div>
        </div>
    </div>

