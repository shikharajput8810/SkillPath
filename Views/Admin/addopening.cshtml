
@{
    ViewBag.Title = "addopening";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<form method="post">
    <div class="container-fluid">
        <div class="row py-2">
            <p class="fs-3 text-center">Add Job<b class="text-mycolor"> Opening</b></p>
            <div class="col-sm-10 mx-auto">
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="title" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Job Title</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="detail" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Job Description</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="type" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Job Type</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="city" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Job Location</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" required name="minsalary" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Minimum Salary</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" required name="maxsalary" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Maximum Salary</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="gender" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Preferred Gender</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="shift" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Shift</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="exp" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Experience</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" required name="education" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Education</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" required name="vacancy" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Vacancies</label>
                        </div>
                    </div>
                    <!--form div end-->
                    <!--form div start-->
                    <div class="col-sm-6">
                        <div class="form-floating mb-3">
                            <input type="date" class="form-control" required name="lastdate" id="floatingInput" placeholder="name@example.com">
                            <label for="floatingInput">Last Date</label>
                        </div>
                    </div>
                    <!--form div end-->
                </div>
                <div class="row">
                    <div class="col-sm-6 mx-auto">
                        <input type="submit" value="Add Job" class="form-control bg-mycolor text-light" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
