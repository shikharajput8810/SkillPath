    <link href="~/Content/css/all.css" rel="stylesheet"/>
    <style>
        .bg-mycolor {
            background: #241c49; /*#FF1744 #FF6D00*/
        }
        .text-mycolor {
            color: #241c49 !important;
        }
        .header{
            min-height:40px;
            padding-top:10px;
        }
        .ic {
            font-size: 20px;
            height: 30px;
            width: 30px;
            text-align: center;
            line-height: 30px;
            border: 1px solid #241c49;
            color: #241c49;
            transition: .5s;
        }
        .ic1 {
            font-size: 20px;
            height: 30px;
            width: 30px;
            text-align: center;
            line-height: 30px;
            border: 1px solid #fff7f1;
            color: #fff7f1;
            transition: .5s;
        }
        .ic:hover {
            background: #FF6D00;
            color: white;
            transition: .5s;
            transform: rotate(360deg);
        }
        #menu ul li a{
            color:white;
            font-size:18px;
        }
        .sliderimg{
            height:500px;
        }
        .servicesimg{
            height:150px;
        }
        .servicescard:hover{
            transform:scale(1.1);
            transition:2s;
        }
        .servicescard{
            transition:2s;
        }
        .ufooter{
            min-height:200px;
        }
        .bfooter{
            height:50px;
        }
        .fact{
            min-height:250px;
        }
        .gallery{
            min-height:300px;
        }
        .team{
            min-height:300px;
        }
        .factic{
            height:80px;
            width:80px;
            border:1px solid grey;
            border-radius:50%;
            font-size:40px;
            line-height:70px;
            transition:2s;
            padding:5px;
            text-align:center;
        }
            .factic:hover {
                background: #241c49;
                color: white;
                transition: 2s;
            }
