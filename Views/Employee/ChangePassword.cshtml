
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

<form method="post" enctype="multipart/form-data">
    <div class="container-fluid">
        <div class="row py-2">
            <div class="col-sm-12">
                <p class="fs-3 text-center">Change <b class="text-mycolor">Password</b></p>
                <hr class="mx-auto w-30" />
            </div>
            <!--changepassword form start-->
            <div class="col-sm-4  mt-3 shadow p-3 mb-5 bg-white rounded mx-auto">
                <h4 class="text-center">Change Password Form</h4>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="opass" id="floatingpass" placeholder="name@example.com">
                    <label for="floatingpass">Old Password</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="npass" id="floatingnpass" placeholder="name@example.com">
                    <label for="floatingnpass">New Password</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" name="cpass" id="floatingcpass" placeholder="name@example.com">
                    <label for="floatingcpass">Re-Enter Password</label>
                </div>
              
                <input type="submit" value="Change Password" class="btn btn-danger"/>
            </div>
        </div>
    </div>
    </form>

